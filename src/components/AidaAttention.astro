---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import MultiLineText from "./i18n/MultiLineText.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const heroTitle = t("hero.title");

const marqueeProducts = (
  await getCollection("products", ({ data }) => data.lang === lang)
).sort((a, b) => (a.data.id || 0) - (b.data.id || 0));

// Duplicate for a seamless infinite loop
const marquee = [...marqueeProducts, ...marqueeProducts];
---

<section id="attention" class="relative flex min-h-svh flex-col overflow-hidden bg-paper">
  <img
    src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=2000&q=80"
    alt=""
    class="absolute inset-0 h-full w-full object-cover opacity-30 mix-blend-multiply animate-hero-pan"
    loading="eager"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 bg-gradient-to-b from-paper/90 via-paper/60 to-paper"
    aria-hidden="true"
  ></div>
  <div class="bg-ruled absolute inset-0 opacity-60" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex w-full max-w-5xl flex-1 flex-col items-center justify-center px-5 pb-14 pt-36 text-center lg:px-8">
    <p class="reveal inline-flex items-center gap-2.5 rounded-full border border-ink/15 bg-surface/80 px-4 py-1.5 font-mono text-[11px] uppercase tracking-[0.22em] text-muted">
      <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
      {lang === "de" ? "Verwaltete Open-Source-Infrastruktur" : "Managed Open-Source Infrastructure"}
    </p>

    <MultiLineText
      lines={heroTitle}
      tag="h1"
      class="hero-title reveal mt-8 font-display text-5xl font-medium leading-[1.02] tracking-tight text-fg sm:text-6xl lg:text-7xl"
    />

    <p
      class="reveal mt-7 max-w-xl text-lg leading-relaxed text-muted sm:text-xl"
      style="--reveal-delay:120ms"
    >
      {t("site.description")}
    </p>

    <div
      class="reveal mt-10 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row"
      style="--reveal-delay:200ms"
    >
      <a href={lang === "de" ? "/#desire" : "/en/#desire"} class="btn-primary w-full sm:w-auto">
        {t("demo.request")}
      </a>
      <a href={lang === "de" ? "/#product" : "/en/#product"} class="btn-ghost group w-full sm:w-auto">
        {t("nav.products")}
        <svg
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>

  <div
    class="reveal relative z-10 border-y border-ink/10 bg-base"
    style="--reveal-delay:280ms"
  >
    <div class="marquee-track items-center py-5" aria-label={t("nav.products")}>
      {marquee.map((product, i) => (
        <div
          class="flex shrink-0 items-center gap-3 px-7"
          aria-hidden={i >= marqueeProducts.length}
        >
          <Image
            src={product.data.icon}
            alt=""
            width={28}
            height={28}
            class="h-7 w-7 object-contain opacity-70"
          />
          <span class="whitespace-nowrap font-display text-sm italic text-muted">
            {product.data.title}
          </span>
          <span
            class="ml-6 h-1.5 w-1.5 rotate-45 bg-accent/60"
            aria-hidden="true"
          ></span>
        </div>
      ))}
    </div>
  </div>
</section>
