---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import MultiLineText from "./i18n/MultiLineText.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const heroTitle = t("hero.title");

const marqueeProducts = (
  await getCollection("products", ({ data }) => data.lang === lang)
).sort((a, b) => (a.data.id || 0) - (b.data.id || 0));

// Duplicate for a seamless infinite loop
const marquee = [...marqueeProducts, ...marqueeProducts];
---

<section id="attention" class="relative flex min-h-svh flex-col overflow-hidden bg-ink">
  <img
    src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=2000&q=80"
    alt=""
    class="absolute inset-0 h-full w-full object-cover opacity-45"
    loading="eager"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 bg-gradient-to-b from-ink/80 via-ink/45 to-ink"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-gradient-to-r from-ink/60 via-transparent to-ink/60"
    aria-hidden="true"
  ></div>
  <div
    class="aurora left-[-10%] top-[-15%] h-[34rem] w-[34rem] bg-accent/20 animate-aurora"
    aria-hidden="true"
  ></div>
  <div
    class="aurora right-[-12%] top-[30%] h-[28rem] w-[28rem] bg-violet/15 animate-aurora-slow"
    aria-hidden="true"
  ></div>
  <div class="bg-grid absolute inset-0 opacity-60" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex w-full max-w-5xl flex-1 flex-col items-center justify-center px-5 pb-14 pt-36 text-center lg:px-8">
    <p class="reveal inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 font-mono text-[11px] uppercase tracking-[0.22em] text-muted backdrop-blur">
      <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent"></span>
      </span>
      {lang === "de" ? "Verwaltete Open-Source-Infrastruktur" : "Managed Open-Source Infrastructure"}
    </p>

    <MultiLineText
      lines={heroTitle}
      tag="h1"
      class="hero-title reveal mt-8 font-display text-4xl font-bold leading-[1.04] tracking-tight text-fg sm:text-6xl lg:text-7xl"
    />

    <p
      class="reveal mt-7 max-w-xl text-lg leading-relaxed text-muted sm:text-xl"
      style="--reveal-delay:120ms"
    >
      {t("site.description")}
    </p>

    <div
      class="reveal mt-10 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row"
      style="--reveal-delay:200ms"
    >
      <a href={lang === "de" ? "/#desire" : "/en/#desire"} class="btn-primary w-full sm:w-auto">
        {t("demo.request")}
      </a>
      <a href={lang === "de" ? "/#product" : "/en/#product"} class="btn-ghost group w-full sm:w-auto">
        {t("nav.products")}
        <svg
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>

  <div
    class="reveal relative z-10 border-y border-white/5 bg-ink/50 backdrop-blur-md"
    style="--reveal-delay:280ms"
  >
    <div class="marquee-track items-center py-5" aria-label={t("nav.products")}>
      {marquee.map((product, i) => (
        <div
          class="flex shrink-0 items-center gap-3 px-7"
          aria-hidden={i >= marqueeProducts.length}
        >
          <Image
            src={product.data.icon}
            alt=""
            width={28}
            height={28}
            class="h-7 w-7 object-contain opacity-60"
          />
          <span class="whitespace-nowrap font-mono text-xs text-faint">
            {product.data.title}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
