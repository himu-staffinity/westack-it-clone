---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import MultiLineText from "./i18n/MultiLineText.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const interestTitle = t("interest.title");
const interestDescription = t("interest.description");

// Grounded technical labels — these mirror actual product names in the portfolio
const stack = ["Kubernetes", "PostgreSQL", "S3", "Supabase", "n8n", "Nextcloud"];
---

<section id="interest" class="relative overflow-hidden bg-base py-28">
  <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-16 px-5 lg:grid-cols-2 lg:px-8">
    <div class="reveal">
      <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-accent">
        {t("nav.about")}
      </p>
      <MultiLineText
        lines={interestTitle}
        tag="h2"
        class="mt-5 font-display text-4xl font-medium leading-[1.08] tracking-tight text-fg sm:text-5xl"
      />
      <MultiLineText
        lines={interestDescription}
        tag="p"
        class="mt-7 max-w-lg text-lg leading-relaxed text-muted"
      />
      <ul class="mt-9 flex flex-wrap gap-2.5">
        {stack.map((item) => (
          <li class="rounded-full border border-ink/15 bg-surface px-3.5 py-1.5 font-mono text-xs text-muted">
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="reveal relative" style="--reveal-delay:140ms">
      <div
        class="relative rounded-card border border-ink/15 bg-surface p-2.5 shadow-plate"
      >
        <img
          src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1200&q=80"
          alt=""
          loading="lazy"
          class="aspect-[4/3] w-full rounded-[calc(1rem-10px)] object-cover"
        />
      </div>
      <div
        class="absolute -bottom-6 left-6 flex items-center gap-3 rounded-xl border border-ink/15 bg-surface px-4 py-3 shadow-card"
      >
        <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
        <p class="text-sm font-medium text-fg">{t("desire.hosted.title")}</p>
      </div>
    </div>
  </div>
</section>
