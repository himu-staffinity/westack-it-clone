---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const { product, buttonTitle } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const defaultButtonTitle = buttonTitle || t("demo.request");

const context = t("demo.context") as string[];
---

<div
  id="demo-request"
  data-product={JSON.stringify(product)}
  class="flex w-full flex-col items-center"
>
  <button id="show-demo-form" class="btn-primary" type="button">
    {defaultButtonTitle}
  </button>

  <form
    id="demo-form"
    style="display:none;"
    class="mt-8 flex w-full max-w-xl flex-col items-center gap-5 rounded-2xl border border-white/10 bg-surface/80 p-8 backdrop-blur-xl"
  >
    <div class="space-y-2 text-center">
      {context.map((line: string) => (
        <p class="text-sm leading-relaxed text-muted">{line}</p>
      ))}
    </div>
    <div class="flex w-full flex-col items-center gap-4 sm:flex-row">
      <input
        type="email"
        id="demo-email"
        placeholder={t("demo.email.placeholder")}
        required
        class="w-full flex-1 rounded-full border border-white/15 bg-ink/60 px-5 py-3 text-sm text-fg outline-none transition placeholder:text-faint focus:border-accent/60 focus:ring-2 focus:ring-accent/20"
      />
      <button type="submit" class="btn-primary shrink-0">
        {t("demo.submit")}
      </button>
    </div>
    <div>
      <p class="text-xs leading-relaxed text-faint">
        {t("demo.approval")}{" "}
        <a
          href={lang === "de" ? "/privacy-policy/" : "/en/privacy-policy/"}
          class="text-accent underline decoration-accent/40 underline-offset-2 transition-colors hover:text-accent-soft"
        >
          {t("footer.privacy")}
        </a>
      </p>
    </div>
  </form>

  <div id="demo-error" class="demo-error mt-4 font-mono text-xs text-red-400">
    {t("demo.error.email")}
  </div>
  <div
    id="demo-server-error"
    class="demo-error mt-4 font-mono text-xs text-red-400"
    style="display:none;"
  >
    {t("demo.error.server")}
  </div>
  <div
    id="demo-thankyou"
    style="display:none;"
    class="mt-8 w-full max-w-xl rounded-2xl border border-accent/30 bg-accent/10 px-6 py-5 text-center text-sm text-accent-soft"
  >
    {t("demo.thankyou")}
  </div>
</div>

<script>
    const showBtn = document.getElementById("show-demo-form");
    const form = document.getElementById("demo-form") as HTMLFormElement;
    const thankyou = document.getElementById("demo-thankyou");
    const errorMsg = document.getElementById("demo-error");
    const serverErrorMsg = document.getElementById("demo-server-error");
    const emailInput = document.getElementById("demo-email") as HTMLInputElement;
    const demoRequestDiv = document.getElementById("demo-request");

    let productData = {};
    if (demoRequestDiv) {
        try {
            productData = JSON.parse(demoRequestDiv.getAttribute("data-product") ?? "");
        } catch {}
    }

    if (showBtn && form && thankyou && errorMsg && serverErrorMsg && emailInput) {
        showBtn.addEventListener("click", () => {
            form.style.display = "";
            showBtn.style.display = "none";
        });

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const email = emailInput.value.trim();

            if (!/^\S+@\S+\.\S+$/.test(email)) {
                errorMsg.classList.add("show");
                return;
            } else {
                errorMsg.classList.remove("show");
            }

            serverErrorMsg.style.display = "none";

            try {
                const res = await fetch("/request-demo", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        email,
                        product: productData,
                    }),
                });

            const data = await res.json();

            if (data.success) {
                form.style.display = "none";
                thankyou.style.display = "";
            } else {
                serverErrorMsg.style.display = "";
            }
            } catch (err) {
                serverErrorMsg.style.display = "";
            }
        });

        emailInput.addEventListener("input", () => {
            errorMsg.classList.remove("show");
            serverErrorMsg.style.display = "none";
        });
    }
</script>
