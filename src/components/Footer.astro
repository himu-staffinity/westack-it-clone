---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.svg";
import { COMPANY_NAME } from "../config";
import { authors } from "../data/authors.js";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import MultiLineText from "./i18n/MultiLineText.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const companyAddress = t("footer.company_address");
const privacyHref = lang === "de" ? "/privacy-policy/" : "/en/privacy-policy/";
---

<footer class="relative overflow-hidden border-t border-white/5 bg-ink">
  <section id="footer" class="relative">
    <img
      src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=1600&q=70"
      alt=""
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover opacity-[0.07]"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-ink via-ink/85 to-ink"
      aria-hidden="true"
    ></div>
    <div
      class="aurora bottom-[-30%] left-[-12%] h-[26rem] w-[26rem] bg-violet/15 animate-aurora-slow"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-6xl px-5 py-20 lg:px-8">
      <div class="reveal grid gap-14 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1.2fr]">
        <div>
          <div class="flex items-center gap-2.5">
            <Image src={logo} alt="" width={28} height={28} class="h-7 w-7" />
            <span class="font-display text-lg font-semibold tracking-tight text-fg">
              WeStack
            </span>
          </div>
          <p class="mt-5 max-w-xs text-sm leading-relaxed text-muted">
            {t("site.description")}
          </p>
          <div class="mt-7 border-l border-white/10 pl-4">
            <MultiLineText
              lines={companyAddress}
              tag="p"
              class="company-address text-xs leading-relaxed text-faint"
            />
            <p class="mt-2 text-xs text-faint">{COMPANY_NAME}</p>
          </div>
        </div>

        <div>
          <h3 class="font-mono text-[11px] uppercase tracking-[0.25em] text-accent">
            {t("footer.contact")}
          </h3>
          <div class="mt-5 space-y-5">
            <div>
              <p class="font-mono text-[10px] uppercase tracking-widest text-faint">
                {t("footer.phone")}
              </p>
              <a
                href="tel:+4991174393000"
                class="mt-1 inline-block text-sm text-fg transition-colors hover:text-accent"
              >
                +49&nbsp;911&nbsp;743&nbsp;930&nbsp;00
              </a>
            </div>
            <div>
              <p class="font-mono text-[10px] uppercase tracking-widest text-faint">
                {t("footer.email")}
              </p>
              <a
                href="mailto:info@westack-it.eu"
                class="mt-1 inline-block text-sm text-fg transition-colors hover:text-accent"
              >
                info@westack-it.eu
              </a>
            </div>
            <div>
              <p class="font-mono text-[10px] uppercase tracking-widest text-faint">
                {t("footer.imprint")}
              </p>
              <p class="mt-1 text-sm text-fg">{COMPANY_NAME}</p>
            </div>
          </div>
        </div>

        <div>
          <ul class="mt-5 space-y-5 lg:mt-0">
            {authors.map((author) => (
              <li class="group flex items-start gap-4">
                <Image
                  src={author.image}
                  alt={author.name}
                  widths={[64, 128, 180]}
                  sizes="64px"
                  height={64}
                  width={64}
                  format="webp"
                  class="h-14 w-14 shrink-0 rounded-full object-cover ring-1 ring-white/10 transition-transform duration-300 group-hover:scale-105"
                />
                <div>
                  <p class="text-sm font-medium text-fg">{author.name}</p>
                  <p class="mt-0.5 text-xs text-muted">
                    {author.title} · {author.role}
                  </p>
                  <a
                    href={`mailto:${author.email}`}
                    class="mt-1 inline-block text-xs text-accent/80 transition-colors hover:text-accent"
                  >
                    {author.email}
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-8 sm:flex-row">
        <p class="text-xs text-faint">© {new Date().getFullYear()} {COMPANY_NAME}</p>
        <a
          href={privacyHref}
          class="text-xs text-faint transition-colors hover:text-accent"
        >
          {t("footer.privacy")}
        </a>
      </div>
    </div>
  </section>
</footer>
