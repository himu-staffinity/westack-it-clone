---
import { Image } from "astro:assets";
import langIcon from "../components/icons/globe.svg";
import {
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from "../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { href: lang === "de" ? "/#interest" : "/en/#interest", label: t("nav.about") },
  { href: lang === "de" ? "/#product" : "/en/#product", label: t("nav.products") },
  { href: lang === "de" ? "/#footer" : "/en/#footer", label: t("nav.contact") },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300"
>
  <nav
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 lg:px-8"
    aria-label="WeStack"
  >
    <a
      href={lang === "en" ? "/en/" : "/"}
      class="group flex shrink-0 items-center gap-2.5"
      aria-label="WeStack"
    >
      <svg
        viewBox="0 0 240 292"
        class="h-8 w-auto shrink-0 text-fg transition-transform duration-300 group-hover:scale-110"
        fill="none"
        stroke="currentColor"
        stroke-width="40"
        stroke-linecap="butt"
        stroke-linejoin="miter"
        stroke-miterlimit="12"
        aria-hidden="true"
      >
        <path d="M40 46 L110 116 L224 18" />
        <path d="M40 110 L110 180 L184 106" />
        <path d="M6 146 L110 250 L184 176" />
      </svg>
      <span class="font-display text-lg font-semibold tracking-tight text-fg">
        WeStack
      </span>
    </a>

    <ul class="nav-links flex list-none items-center gap-1 lg:ml-auto" id="nav-links">
      {links.map((link) => (
        <li>
          <a class="nav-link" href={link.href}>
            {link.label}
          </a>
        </li>
      ))}
      <li class="ml-4 hidden lg:block">
        <LanguageSwitcher />
      </li>
      <li class="hidden lg:block">
        <button
          type="button"
          id="theme-toggle-desktop"
          class="theme-toggle flex h-9 w-9 items-center justify-center rounded-full border border-fg/15 bg-surface/60 text-base backdrop-blur-md transition-colors hover:border-accent/50"
          aria-label={lang === "de" ? "Farbschema wechseln" : "Toggle theme"}
        ></button>
      </li>
    </ul>

    <div class="relative z-50 flex items-center gap-3 lg:hidden">
      <button
        type="button"
        id="theme-toggle-mobile"
        class="theme-toggle flex h-9 w-9 items-center justify-center rounded-full border border-fg/15 bg-surface/60 text-base backdrop-blur-md transition-colors hover:border-accent/50"
        aria-label={lang === "de" ? "Farbschema wechseln" : "Toggle theme"}
      ></button>
      <a
        href={getLocalizedPath(Astro.url.pathname, lang === "de" ? "en" : "de")}
        class="flex h-9 w-9 items-center justify-center rounded-full border border-fg/15 bg-surface/60 text-muted backdrop-blur-md transition-colors hover:border-accent/50 hover:text-accent"
        aria-label={lang === "de" ? "Switch to English" : "Switch to German"}
      >
        <Image
          src={langIcon}
          alt=""
          width={18}
          height={18}
          class="h-[18px] w-[18px]"
        />
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="menu-btn flex h-9 w-9 items-center justify-center rounded-full border border-fg/15 bg-surface/60 text-fg backdrop-blur-md transition-colors hover:border-accent/50"
        aria-expanded="false"
        aria-controls="nav-links"
        aria-label={lang === "de" ? "Menü" : "Menu"}
      >
        <span class="menu-bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById("menu-toggle");
  const navLinks = document.getElementById("nav-links");

  const themeButtons = document.querySelectorAll(".theme-toggle");
  const isLight = () => document.documentElement.classList.contains("light");
  const syncThemeButtons = () => {
    themeButtons.forEach((b) => {
      b.textContent = isLight() ? "🌙" : "☀️";
    });
  };
  themeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const light = isLight();
      document.documentElement.classList.toggle("light", !light);
      try {
        localStorage.setItem("theme", !light ? "light" : "dark");
      } catch (e) {}
      syncThemeButtons();
    });
  });
  syncThemeButtons();

  if (toggleBtn && navLinks) {
    const setOpen = (open: boolean) => {
      navLinks.classList.toggle("show", open);
      toggleBtn.classList.toggle("open", open);
      toggleBtn.setAttribute("aria-expanded", String(open));
      document.body.classList.toggle("no-scroll", open);
    };

    toggleBtn.addEventListener("click", () => {
      setOpen(!navLinks.classList.contains("show"));
    });

    navLinks.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) setOpen(false);
    });
  }
</script>
