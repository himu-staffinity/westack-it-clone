---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.svg";
import langIcon from "../components/icons/globe.svg";
import {
  getLangFromUrl,
  getLocalizedPath,
  useTranslations,
} from "../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { href: lang === "de" ? "/#interest" : "/en/#interest", label: t("nav.about") },
  { href: lang === "de" ? "/#product" : "/en/#product", label: t("nav.products") },
  { href: lang === "de" ? "/#footer" : "/en/#footer", label: t("nav.contact") },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-ink/70 backdrop-blur-xl transition-colors duration-300"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 lg:px-8" aria-label="WeStack">
    <a href={lang === "en" ? "/en/" : "/"} class="group flex shrink-0 items-center gap-2.5" aria-label="WeStack">
      <Image
        src={logo}
        alt=""
        width={32}
        height={32}
        class="h-8 w-8 transition-transform duration-300 group-hover:scale-110"
      />
      <span class="font-display text-lg font-semibold tracking-tight text-fg">
        WeStack
      </span>
    </a>

    <ul class="nav-links flex list-none gap-1 lg:ml-auto" id="nav-links">
      {links.map((link) => (
        <li>
          <a class="nav-link" href={link.href}>
            {link.label}
          </a>
        </li>
      ))}
      <li class="mt-2 lg:ml-3 lg:mt-0">
        <LanguageSwitcher />
      </li>
    </ul>

    <div class="relative z-50 flex items-center gap-3 lg:hidden">
      <a
        href={getLocalizedPath(Astro.url.pathname, lang === "de" ? "en" : "de")}
        class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/5 text-muted transition-colors hover:border-accent/40 hover:text-fg"
        aria-label={lang === "de" ? "Switch to English" : "Switch to German"}
      >
        <Image
          src={langIcon}
          alt=""
          width={18}
          height={18}
          class="h-[18px] w-[18px] invert"
        />
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="menu-btn flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/5 text-fg transition-colors hover:border-accent/40"
        aria-expanded="false"
        aria-controls="nav-links"
        aria-label={lang === "de" ? "Menü" : "Menu"}
      >
        <span class="menu-bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.getElementById("site-header");
    if (header) {
      const onScroll = () => {
        header.classList.toggle("scrolled", window.scrollY > 12);
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }

    const toggleBtn = document.getElementById("menu-toggle");
    const navLinks = document.getElementById("nav-links");

    if (toggleBtn && navLinks) {
      const setOpen = (open) => {
        navLinks.classList.toggle("show", open);
        toggleBtn.classList.toggle("open", open);
        toggleBtn.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("no-scroll", open);
      };

      toggleBtn.addEventListener("click", () => {
        setOpen(!navLinks.classList.contains("show"));
      });

      navLinks.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 1024) setOpen(false);
      });
    }
  });
</script>
