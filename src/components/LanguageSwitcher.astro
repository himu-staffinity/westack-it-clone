---
import { getLangFromUrl, getLocalizedPath, languages } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
---

<div class="flex items-center rounded-full border border-white/10 bg-white/5 p-0.5 font-mono text-[11px] tracking-widest">
  {
    Object.entries(languages).map(([locale, label]) => (
      <a
        href={getLocalizedPath(
          currentPath,
          locale as keyof typeof languages,
        )}
        class={
          locale === lang
            ? "rounded-full bg-accent px-2.5 py-1 font-semibold text-ink transition-colors duration-300"
            : "rounded-full px-2.5 py-1 text-muted transition-colors duration-300 hover:text-fg"
        }
        aria-label={`Switch to ${label}`}
        aria-current={locale === lang ? "true" : undefined}
      >
        {locale.toUpperCase()}
      </a>
    ))
  }
</div>
