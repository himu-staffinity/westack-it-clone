---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Layout from "../layouts/Layout.astro";
import DemoRequest from "./DemoRequest.astro";
import FAQ from "../components/FAQ.astro";

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Get products for the current language
const products = (
    await getCollection("products", ({ data }) => data.lang === lang)
).sort((a, b) => (a.data.id || 0) - (b.data.id || 0));

// Find product by slug, handling nested directory structure
const product = products.find((p: any) => {
    const productSlug = p.slug.includes("/") ? p.slug.split("/")[1] : p.slug;
    return productSlug === slug;
});
if (!product) throw new Error("Product not found");

// Render the markdown content
const { Content } = await product.render();

// This type definition assumes your `icon` field is an imported image
type FAQItem = {
  name: string;
  acceptedAnswer: string;
};

export type ProductData = {
    id: number;
    title: string;
    description: string;
    // The icon field should be typed as an imported image object
    icon: any;
    iconPNG: any;
    tags?: string[];
    price: number;
    priceComment: string;
    lang: string;
    faq: FAQItem[];
};

const productData = product.data as ProductData;

// Generate Schema.org structured data for the product
function generateStructuredData(productData: ProductData, slug: string) {
    const structuredData = {
        "@context": "https://schema.org",
        "@type": "Product",
        name: productData.title,
        description: productData.description,
        // The image path for structured data must be a string, and it's relative to the site root
        image: `${Astro.site}${productData.iconPNG.src}`,
        url:
            lang === "de"
                ? `${Astro.site}products/${slug}`
                : `${Astro.site}en/products/${slug}`,
        contact: {
            "@type": "Contact",
            telephone: "+49 163 1944 738",
            email: "info@westack-it.eu",
        },
        offers: {
            "@type": "Offer",
            availability: "https://schema.org/InStock",
            priceType: "https://schema.org/FromPrice",
            priceCurrency: "EUR",
            price: productData.price.toString(),
            priceValidUntil: new Date(Date.now() + 365 * 24 * 60 * 60 * 1000)
                .toISOString()
                .split("T")[0],

            availableDeliveryMethod: "https://schema.org/Download",
            hasMerchantReturnPolicy: {
                "@type": "MerchantReturnPolicy",
                applicableCountry: "DE",
                returnPolicyCategory:
                    "https://schema.org/MerchantReturnFiniteReturnWindow",
                merchantReturnDays: 14,
                returnFees: "https://schema.org/FreeReturn",
            },
        },
        keywords: productData.tags ? productData.tags.join(", ") : "",
        category: "Software Service",
    };

    return JSON.stringify(structuredData);
}
---

<Layout
    canonical={lang === "de"
        ? `${Astro.site}products/${slug}/`
        : `${Astro.site}en/products/${slug}/`}
>
    <script
        type="application/ld+json"
        is:inline
        set:html={generateStructuredData(productData, slug!)}
    />
    <section class="relative overflow-hidden bg-paper">
        <img
            src="https://images.unsplash.com/photo-1544197150-b99a580bb7a8?auto=format&fit=crop&w=1600&q=70"
            alt=""
            loading="eager"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover opacity-15 mix-blend-screen"
        />
        <div
            class="absolute inset-0 bg-gradient-to-b from-paper via-paper/80 to-paper"
            aria-hidden="true"
        ></div>
        <div class="bg-grid absolute inset-0 opacity-40" aria-hidden="true"></div>
        <div
            class="aurora left-[-8%] top-[15%] h-[40vh] w-[40vh] bg-accent/15 animate-aurora"
            aria-hidden="true"
        ></div>

        <div class="relative z-10 mx-auto max-w-7xl px-5 pb-24 pt-32 lg:px-8 lg:pt-36">
            <a
                href={lang === "de" ? "/#product" : "/en/#product"}
                class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted transition-colors hover:text-accent"
            >
                <svg
                    class="h-3.5 w-3.5 transition-transform duration-300 group-hover:-translate-x-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                >
                    <path d="M19 12H5M11 6l-6 6 6 6" />
                </svg>
                {t("nav.products")}
            </a>

            <div class="mt-12 grid gap-12 lg:grid-cols-[1.5fr_1fr]">
                <div class="reveal">
                    <div
                        class="flex h-20 w-20 items-center justify-center rounded-well border border-fg/10 bg-surface/60 p-4 shadow-card backdrop-blur-md"
                    >
                        <Image
                            src={product.data.icon}
                            alt={productData.title}
                            width={80}
                            height={80}
                            class="h-full w-full object-contain"
                        />
                    </div>
                    <h1
                        class="mt-7 font-display font-semibold leading-[1.02] tracking-tight text-fg"
                        style="font-size: clamp(2.25rem, 5vw, 3.75rem)"
                    >
                        {productData.title}
                    </h1>
                    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
                        {productData.description}
                    </p>
                    {
                        productData.tags && productData.tags.length > 0 && (
                            <div class="mt-7 flex flex-wrap gap-2">
                                {productData.tags.slice(0, 6).map((tag) => (
                                    <span class="rounded-full border border-fg/10 bg-raised/40 px-3 py-1 font-mono text-[11px] text-faint">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        )
                    }
                </div>

                <aside class="reveal" style="--reveal-delay:140ms">
                    <div class="rounded-card border border-fg/15 bg-surface/60 p-7 shadow-lift backdrop-blur-md lg:sticky lg:top-24">
                        <p class="font-mono text-[11px] uppercase tracking-widest text-faint">
                            {t("products.price_offer")}
                        </p>
                        <p class="mt-2 font-display text-5xl font-semibold text-fg">
                            €{productData.price}
                            <span class="ml-2 align-middle text-base font-normal text-faint">
                                {t("products.price_period")}
                            </span>
                        </p>
                        {
                            productData.priceComment && (
                                <p class="mt-3 text-sm text-accent">
                                    {productData.priceComment}
                                </p>
                            )
                        }
                        <DemoRequest
                            product={{ slug: product.slug, ...productData }}
                            buttonTitle={t("demo.request")}
                        />
                        <p class="mt-5 border-t border-fg/10 pt-5 text-xs leading-relaxed text-faint">
                            {t("desire.hosted.title")} · {t("desire.gdpr.title")}
                        </p>
                    </div>
                </aside>
            </div>

            <article class="prose reveal mx-auto mt-24 max-w-3xl">
                <Content />
            </article>

            {productData.faq.length > 0 && (
                <div class="reveal mt-24">
                    <FAQ items={productData.faq} />
                </div>
            )}
        </div>
    </section>
</Layout>
