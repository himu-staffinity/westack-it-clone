---
import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import { getLangFromUrl } from "../i18n/utils";
import "../styles/global.css";

const { canonical } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head canonical={canonical} lang={lang} />
    <noscript>
      <style>
        .reveal,
        .line-inner,
        .word > span {
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
        }
        body {
          overflow: auto !important;
        }
      </style>
    </noscript>
  </head>
  <body class="bg-paper font-sans text-fg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[300] focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:font-semibold focus:uppercase focus:tracking-wider focus:text-ink"
    >
      {lang === "de" ? "Zum Inhalt springen" : "Skip to content"}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<script>
  import "../scripts/site.js";
</script>
