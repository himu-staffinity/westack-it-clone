---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const pages = await getCollection('pages');

const privacySlug = `${lang}/privacy-policy`;
const privacy = pages.find(entry => entry.slug === privacySlug);

if (!privacy) {
  return Astro.redirect('/'); 
}

const { Content } = await privacy.render();
---

<Layout title={privacy.data.title}>
  <div class="relative overflow-hidden">
    <div
      class="aurora right-[-15%] top-[-10%] h-[26rem] w-[26rem] bg-accent/10 animate-aurora-slow"
      aria-hidden="true"
    ></div>
    <article class="privacy relative mx-auto max-w-3xl px-5 pb-28 pt-32 lg:px-8 lg:pt-36">
      <h1 class="reveal font-display text-4xl font-bold tracking-tight text-fg sm:text-5xl">
        {privacy.data.title}
      </h1>
      <div class="prose-dark reveal mt-10">
        <Content />
      </div>
    </article>
  </div>
</Layout>
