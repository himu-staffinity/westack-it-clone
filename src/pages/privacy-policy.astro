---

import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const pages = await getCollection('pages');
const privacy = pages.find(entry => entry.slug === 'de/privacy-policy');

if (!privacy) {
  return Astro.redirect('/'); 
}

const { Content } = await privacy.render();
---

<Layout title={privacy.data.title}>
  <div class="relative overflow-hidden">
    <div class="bg-ruled absolute inset-0 opacity-40" aria-hidden="true"></div>
    <article class="privacy relative mx-auto max-w-3xl px-5 pb-28 pt-32 lg:px-8 lg:pt-36">
      <h1 class="reveal font-display text-4xl font-medium tracking-tight text-fg sm:text-5xl">
        {privacy.data.title}
      </h1>
      <div class="prose reveal mt-10">
        <Content />
      </div>
    </article>
  </div>
</Layout>
